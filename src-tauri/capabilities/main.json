{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-ui",
  "description": "Main window capability",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:tray:default",
    "global-shortcut:default",
    "core:window:allow-start-dragging",
    "allow-ytm-search",
    "allow-player-sync",
    "allow-window-action",
    "allow-get-settings",
    "allow-set-settings",
    "allow-window-deco-mode",
    "allow-pl-list",
    "allow-pl-save",
    "allow-pl-add",
    "allow-pl-delete",
    "allow-pl-remove-track",
    "allow-pl-save-source",
    "allow-ytm-playlist"
  ]
}
